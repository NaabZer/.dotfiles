[global]
frame_color = "#81b5ac"
separator_color = "#81b5ac"

[base16_low]
    msg_urgency = "low"
    background = "#0b342dcc"
    foreground = "#2b685e"

[base16_normal]
    msg_urgency = "normal"
    background = "#184e45cc"
    foreground = "#81b5ac"

[base16_critical]
    msg_urgency = "critical"
    background = "#3e9688cc"
    foreground = "#a7cec8"
# SOURCE for the dunst config. EDIT THIS FILE, not gui/dunst/dunstrc.
#
# The live gui/dunst/dunstrc is GENERATED by install_colors.sh as:
#   cat gui/dunst/colors gui/dunst/dunstrc_base > gui/dunst/dunstrc
# gui/dunst/colors holds the downloaded base16 theme, so [global] appears
# twice in the final file (theme section first, ours second) — dunst merges
# repeated sections, with later keys overriding earlier ones.

[global]
# Show notifications on monitor with keyboard focus (active window)
follow = keyboard

# Invoke action on left-click instead of closing
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current
